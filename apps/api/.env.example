PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/site-car
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=https://your-frontend.onrender.com

# Optional: create the first admin automatically on API startup if no admin exists yet.
ADMIN_BOOTSTRAP_NAME=HAROU HEDWANI Admin
ADMIN_BOOTSTRAP_EMAIL=admin@harouhedwani.com
ADMIN_BOOTSTRAP_PASSWORD=change_this_admin_password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=demo@example.com
SMTP_PASS=secret
SMTP_FROM="HAROU HEDWANI <no-reply@harouhedwani.com>"

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
